<Window x:Class="WpfSandbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSandbox"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <local:FreeCellGrid x:Name="freeCellGrid">
            <local:FreeCellGrid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </local:FreeCellGrid.ColumnDefinitions>
            <local:FreeCellGrid.CellInfos>
                <local:CellInfo Column="1" ColumnSpan="1">
                    <local:CellInfo.CellControlFactory>
                        <local:ContentPresenterCellFactory>
                            <local:ContentPresenterCellFactory.Template>
                                <DataTemplate DataType="local:SampleData">
                                    <Border Height="Auto" Margin="5" Background="#FF0DFDC9">
                                        <TextBlock Text="{Binding AAA, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </local:ContentPresenterCellFactory.Template>
                        </local:ContentPresenterCellFactory>
                    </local:CellInfo.CellControlFactory>
                </local:CellInfo>
                <local:CellInfo Column="2" ColumnSpan="2">
                    <local:CellInfo.CellControlFactory>
                        <local:ContentPresenterCellFactory>
                            <local:ContentPresenterCellFactory.Template>
                                <DataTemplate DataType="local:SampleData">
                                    <Button Content="{Binding BBB, Mode=OneWay}"/>
                                </DataTemplate>
                            </local:ContentPresenterCellFactory.Template>
                        </local:ContentPresenterCellFactory>
                    </local:CellInfo.CellControlFactory>
                </local:CellInfo>
            </local:FreeCellGrid.CellInfos>
        </local:FreeCellGrid>
    </Grid>
</Window>
